{
  "name": "@adaptive-auth/auth-server",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:tokens": "tsx scripts/migrate-legacy-tokens.ts",
    "start": "node dist/server.js",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix"
  },
  "dependencies": {
    "@adaptive-auth/shared-types": "workspace:*",
    "@adaptive-auth/validation": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cryptr": "^6.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "nodemailer": "^8.0.8",
    "nodemailer-express-handlebars": "^7.0.0",
    "rate-limiter-flexible": "^11.1.0",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@adaptive-auth/config-typescript": "workspace:*",
    "@adaptive-auth/eslint-config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@types/ua-parser-js": "^0.7.39",
    "mongodb-memory-server": "^11.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
