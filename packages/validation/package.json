{
  "name": "@adaptive-auth/validation",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Zod schemas for AdaptiveAuth API and forms",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
